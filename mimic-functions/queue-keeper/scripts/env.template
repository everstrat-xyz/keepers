# Copy to scripts/.env. Never commit it.

# Private key for signing triggers
PRIVATE_KEY=your_private_key_here

# Function inputs — all required by manifest.yaml
CHAIN_ID=10
QUEUE_EXECUTOR_ADDRESS=
CONTROLLER_ADDRESS=
EXIT_QUEUE_ADDRESS=
AMM_ADDRESS=
# Assigned when the trigger is created; also the address ADMIN must pass to
# QueueKeeperExecutor.allowExecutorCaller().
SMART_ACCOUNT_ADDRESS=

# Optional (defaults shown)
# MAX_BATCHES=250
# MAX_REQUESTS_PER_BATCH=50
# MAX_FEE=1
# CRON_SCHEDULE=*/5 * * * *

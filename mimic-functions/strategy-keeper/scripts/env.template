# Copy to scripts/.env. Never commit it.
#
# One source of truth for all three scripts (create-trigger, try-function,
# get-trigger-prefill-url) — they build inputs from scripts/inputs.ts, which
# reads this file.

# Private key for signing trigger creation (create-trigger only)
PRIVATE_KEY=your_private_key_here

# Printed by `mimic deploy` (create-trigger + prefill-url)
FUNCTION_CID=

# Function inputs — all required by manifest.yaml
CHAIN_ID=10
STRATEGY_EXECUTOR_ADDRESS=

# Look this up in the Mimic Protocol App (this chain) *before* creating a
# live trigger. Dry-run / prefill substitute 0x0. create-trigger requires it.
# Same address ADMIN passes to allowExecutorCaller().
SMART_ACCOUNT_ADDRESS=

# Optional (defaults shown)
# MAX_FEE=1
# CRON_SCHEDULE=*/5 * * * *
# How long after each scheduled tick an execution stays valid. Must match
# /^[0-9]+(s|m|h|d|w)$/ — keep it at or below the cron interval.
# TRIGGER_DELTA=5m
# Mimic requires every trigger to carry an expiry; default is one year out.
# When it passes the keeper goes quiet with NO on-chain signal, so whatever
# watches executor liveness must watch this date too. ISO 8601.
# TRIGGER_END_DATE=2027-01-01T00:00:00Z
# ORACLE_URL=https://api-protocol.mimic.fi/oracle

# Copy to `.env` and fill in. Never commit `.env`.
#
# CRE CLI / simulation
# 64-char hex private key WITHOUT 0x prefix. Required by the simulator even for
# read-only / shadow workflows. Use a funded Sepolia key before onchain writes.
CRE_ETH_PRIVATE_KEY=

# Non-interactive auth (CI / headless). Prefer over `cre login` in automation.
# Create under Organization → APIs in the CRE UI (requires deploy Early Access).
# CRE_API_KEY=

# RPC endpoints referenced by project.yaml (${VAR} interpolation)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAINNET_RPC_URL=

# Optional: default CLI target (overridden by --target)
# CRE_TARGET=staging-settings

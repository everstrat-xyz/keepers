# Copy to `.env` and fill in. Never commit `.env`.
#
# W4 (freeze-watch) still runs on CRE until its own migration lands — these
# are its variables. The Mimic functions (W1/W2) take their config as task
# inputs (chainId, registry, executor, smartAccount, maxFee), not env vars;
# the Mimic CLI reads its own auth from `mimic login`.

# CRE CLI / simulation (W4 only)
# 64-char hex private key WITHOUT 0x prefix. Required by the simulator even for
# read-only / shadow workflows.
CRE_ETH_PRIVATE_KEY=

# Non-interactive auth (CI / headless). Prefer over `cre login` in automation.
# Create under Organization → APIs in the CRE UI.
# CRE_API_KEY=

# RPC endpoints referenced by project.yaml (${VAR} interpolation)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAINNET_RPC_URL=

# Optional: default CLI target (overridden by --target)
# CRE_TARGET=staging-settings
